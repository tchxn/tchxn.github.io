---
import '../styles/global.css';
const { title = 'Thomas Chen', description = 'Thomas Chen, information systems and design in Melbourne. Systems and service design, UX, video and photography. Master of Information Systems student at the University of Melbourne, finishing December 2027. Swims for Papua New Guinea.', section = '' } = Astro.props;
const site = 'https://tchxn.github.io';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/favicon.png" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${site}/assets/poster.jpg`} />
<meta property="og:url" content={site} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#FFFFFF" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
</head>
<body>
<div class="wrap">
  <header class="site-head">
    <a href="/" class="name">Thomas Chen</a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <a href="/projects/" aria-current={section === 'projects' ? 'page' : undefined}>Work</a>
      <a href="/visual/" aria-current={section === 'visual' ? 'page' : undefined}>Visual</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div class="head-right">
      <a href="https://cal.com/thomas-chen" class="head-cta">Book a 15-minute call</a>
      <a href="https://cal.com/thomas-chen" class="btn pri head-book">Book a call</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
        <svg aria-hidden="true" width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 1h20M0 7h20M0 13h20" /></svg>
      </button>
    </div>
  </header>
</div>

<main><slot /></main>

<div class="wrap">
  <footer class="site-foot">
    <span>Thomas Chen · Melbourne · Usually replies within a day</span>
    <nav aria-label="Elsewhere">
      <a href="mailto:thomasjiahao@gmail.com">Email</a>
      <a href="https://linkedin.com/in/thomas-j-chen">LinkedIn</a>
      <a href="https://cal.com/thomas-chen">Book a call</a>
    </nav>
  </footer>
</div>

<script is:inline>
  // phone menu: the nav collapses behind one button under 760px
  (function(){
    const b=document.getElementById('menu-btn'), n=document.getElementById('site-nav');
    if(!b||!n) return;
    b.onclick=()=>{const o=n.classList.toggle('open');b.setAttribute('aria-expanded',o);b.setAttribute('aria-label',o?'Close menu':'Open menu')};
    n.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{n.classList.remove('open');b.setAttribute('aria-expanded','false')}));
  })();
</script>
</body>
</html>
