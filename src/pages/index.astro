---
import Base from '../layouts/Base.astro';

// Selected work, chosen by a hiring-panel review (Oct 2026): each card states context, role and result.
// Two feature cards, then four portrait cards. Delivery Control has its own case section further down.
const features = [
  { href:'/projects/toolbox-education/', img:'/assets/toolbox.webp', alt:'Toolbox Education website on a screen in an office', tag:'Systems · UX & systems intern · 2025', sys:true, title:'Toolbox Education', sum:'Parents and principals were landing on the same pages, so enquiries got answered twice or not at all. I regrouped 20+ pages by who is asking and routed enquiries into their HubSpot CRM.' },
  { href:'/projects/an-extension-of-myself/', img:'/assets/exh-install.webp', alt:'Thomas standing between a black and a pink guardian lion under the exhibition title wall', tag:'Visual · Solo exhibition · 2023', title:'An Extension of Myself', sum:'First solo show, earned through the Tanks Arts Centre Curator\'s Award. Court House Gallery, Cairns: 9,731 visitors, 4 works sold.' },
];
const rest = [
  { href:'/projects/mend-and-mind/', img:'/assets/mm-human.webp', alt:'Chatbot conversation where the user asks for a real person and the bot hands over to a team member', tag:'Systems · Service design · Academic · 2025', sys:true, title:'Mend & Mind', sum:'A clothes-mending service for students. In a team of three I built the booking chatbot: three prototypes, each changed by testing, wired to a live Airtable API.', fit:'contain' },
  { href:'/projects/fortus/', img:'/assets/fortus-2.webp', alt:'Two Fortus app screens on phones', tag:'Systems · UI/UX designer · 2024–25', sys:true, title:'Fortus', sum:'Redesigned five interfaces for a fitness product around one component system. The client reports +32% weekly active users.', bg:'#1B1B1B' },
  { href:'/projects/melbourne-vicentre/', img:'/assets/mvc-hoodie-front.webp', alt:'Melbourne Vicentre club hoodie carrying the new marks', tag:'Brand · Designer & account lead · 2026', sys:true, title:'Melbourne Vicentre', sum:'Live client on retainer. Marks, palette and guidelines for Melbourne Vicentre Swimming Club, reworked when red washed out on navy at the pool.' },
  { href:'/visual/#ezywrk', img:'/assets/v/ezywrk-03.webp', alt:'Black car with EZYWRK plates in an underground car park', tag:'Visual · Commercial · 2024', title:'Ezywrk', sum:'Commercial car shoot: rolling, tunnel and car-park frames.' },
];
---
<Base title="Thomas Chen · Information systems and design, Melbourne">
<div class="wrap">

  <div class="meta">
    <div><b>Practice</b><span>Information systems &amp; design</span></div>
    <div><b>Based</b><span>Melbourne, AEST</span></div>
    <div><b>Studying</b><span>M. Information Systems, UniMelb, to 2027</span></div>
    <div><b>Open to</b><span>BA, systems &amp; product roles · video and photo work</span></div>
  </div>

  <section class="hero">
    <h1>I find where operations break, and make the fix easy to see.</h1>
    <p>Systems and service design is the work. Years behind a camera are why people understand it when I show them. Start with either.</p>
  </section>

  <section class="doors" aria-label="Two ways in">
    <a class="door sys" href="/projects/">
      <div class="door-head"><b>Systems</b><span>BA · service design · UX</span></div>
      <div class="slip">
        <div>
          <span class="lab">Before · the slip</span>
          <span class="hand">6 × rice, 4 × cooking oil<br />K615 cash?<br />driver: <s>the usual guy</s><br /><s>paid? ask later</s></span>
        </div>
        <div>
          <span class="lab ac">After · the audit trail</span>
          <span class="row"><span>Packed · warehouse</span><span>08:12</span></span>
          <span class="row"><span>Assigned · dispatcher</span><span>08:40</span></span>
          <span class="row"><span>Delivered · proof</span><span>11:26</span></span>
          <span class="row"><span>Cash reconciled</span><span>16:03</span></span>
        </div>
      </div>
      <div class="door-foot">
        <span>Delivery Control, Fortus, Toolbox Education and more. Where the process broke, and what I changed.</span>
        <span class="door-go">Open systems work</span>
      </div>
    </a>
    <a class="door vis" href="/visual/">
      <img src="/assets/v/s15-03.webp" alt="Black Nissan Silvia S15 at night" />
      <div class="door-body">
        <div class="door-head"><b>Visual</b><span>Video · photography</span></div>
        <div class="door-foot">
          <span>Thirty-plus commercial jobs since 2020. Automotive, brand, event and exhibition.</span>
          <span class="door-go">Open the archive</span>
        </div>
      </div>
    </a>
  </section>

  <section class="sec" id="work">
    <div class="sec-head"><h2>Selected work</h2><a href="/projects/">All projects</a></div>
    <div class="sel">
      <div class="sel-row two">
        {features.map(w=>(
        <a class="card" href={w.href}>
          <img src={w.img} alt={w.alt} loading="lazy" class={w.fit === 'contain' ? 'fit' : undefined} style={w.bg ? `background:${w.bg}` : undefined} />
          <span class={w.sys ? 'tag sys' : 'tag'}>{w.tag}</span>
          <span class="ttl">{w.title}</span>
          <span class="sum">{w.sum}</span>
        </a>
        ))}
      </div>
      <div class="sel-row four">
        {rest.map(w=>(
        <a class="card" href={w.href}>
          <img src={w.img} alt={w.alt} loading="lazy" class={w.fit === 'contain' ? 'fit' : undefined} style={w.bg ? `background:${w.bg}` : undefined} />
          <span class={w.sys ? 'tag sys' : 'tag'}>{w.tag}</span>
          <span class="ttl">{w.title}</span>
          <span class="sum">{w.sum}</span>
        </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec case" id="case">
    <div class="case-top"><span class="kicker">Case 01 · Delivery Control</span><span>Problem analysis · systems design · 2026</span></div>
    <h2>The business thought it had a paperwork problem. It had an accountability problem.</h2>
    <img src="/assets/dc-dashboard.webp" alt="Delivery Control dashboard showing recent orders and active dispatches" loading="lazy" />
    <div class="steps">
      <div><b>As found</b><p>A handwritten slip: order, value, "the usual guy", "paid? ask later". Nothing tied an order to the person, vehicle and outcome behind it.</p></div>
      <div><b>Taken apart</b><p>Six stages, five roles. In transit and delivered were the blind spots, so that is where stock and cash went missing.</p></div>
      <div><b>Put back</b><p>An append-only audit trail everything else serves. I wrote the spec and data model and directed an AI agent to build it. Demoed, not yet rolled out.</p></div>
    </div>
    <a class="btn" href="/projects/delivery-control/">Read the case study</a>
  </section>

  <section class="sec about" id="about">
    <div class="about-side">
      <h2>About</h2>
      <img src="/assets/me-suit.webp" alt="Thomas Chen in a suit in a Melbourne garden at dusk" loading="lazy" />
      <dl class="facts">
        <div><dt>Studying</dt><dd>M. Information Systems</dd></div>
        <div><dt>Before that</dt><dd>B. Design, UX major</dd></div>
        <div><dt>Languages</dt><dd>English · 中文 · Tok Pisin</dd></div>
        <div><dt>Swimming</dt><dd>Team PNG, 2023–</dd></div>
        <div><dt>Next meet</dt><dd>SC Worlds, Beijing</dd></div>
      </dl>
    </div>
    <div class="about-text">
      <p class="lead">I'm doing a Master of Information Systems at the University of Melbourne, after a design degree majoring in UX. In practice I'm as comfortable modelling roles and permissions as running a usability session.</p>
      <p>Since 2022 I've done operations and systems support for a family business in Papua New Guinea: two sites, each a retail front with manufacturing and a warehouse behind it, plus a delivery fleet. The slip in Case 01 is real.</p>
      <p>I swim for Papua New Guinea in the 50 breaststroke, butterfly and freestyle, at World Championships, Pacific Games and Oceania Championships. Coming back from labrum surgery and an ACL reconstruction took two years, and taught me more about following a plan than any job has.</p>
      <p>Away from a screen I work on cars and fix machinery. Same instinct as everything above.</p>
    </div>
  </section>

  <section class="sec contact" id="contact">
    <span class="kicker">Contact</span>
    <h2>Tell me what's not working.</h2>
    <p>Hiring for systems, BA or product? Need video or photography? Fifteen minutes is usually enough to know if it's a fit.</p>
    <div class="btns">
      <a class="btn pri" href="https://cal.com/thomas-chen">Book a call</a>
      <a class="btn" href="mailto:thomasjiahao@gmail.com">thomasjiahao@gmail.com</a>
      <a class="btn" href="https://linkedin.com/in/thomas-j-chen">LinkedIn</a>
    </div>
  </section>

</div>
</Base>
